{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "strict": true,
    "skipLibCheck": true,
    
    // 👇 ESTAS SON LAS DOS LÍNEAS NUEVAS QUE AGREGAMOS PARA LIMPIAR LOS ERRORES
    "rootDir": "./src",
    "ignoreDeprecations": "6.0"
  }
}